# clangd configuration for the usermode client (client.vcxproj, Release|x64).
#
# Mirrors the real MSBuild build: <CharacterSet>Unicode</CharacterSet> and
# /std:c++20, against the Windows 10 SDK. Toolchain on this machine:
#   Windows SDK 10.0.28000.0
#   MSVC 19.51.36260 (14.51.36231), VS 18 BuildTools

CompileFlags:
  Add:
    - "--target=x86_64-pc-windows-msvc"
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-fms-compatibility-version=19.51.36260"
    - "-std=c++20"

    # CharacterSet=Unicode, plus the Release|x64 definitions
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-D_CONSOLE"
    - "-DNDEBUG"

    # Windows SDK headers (system headers, so their warnings stay quiet)
    # Joined form (-isystem<dir>) so every array item is unique; YAML linters
    # flag repeated scalars such as a bare "-isystem" as duplicate items.
    - "-isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/um"
    - "-isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/shared"
    - "-isystemC:/Program Files (x86)/Microsoft Visual Studio/18/BuildTools/VC/Tools/MSVC/14.51.36231/include"
    - "-isystemC:/Program Files (x86)/Windows Kits/10/Include/10.0.28000.0/ucrt"
